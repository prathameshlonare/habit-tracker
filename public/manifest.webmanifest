{
  "name": "HabitTracker - Track Your Daily Habits",
  "short_name": "Habits",
  "description": "Track habits, build consistency, reflect on growth.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fafc",
  "theme_color": "#4f46e5",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "url": "./#/",
      "description": "Open today's habits"
    },
    {
      "name": "Journal",
      "url": "./#/journal",
      "description": "Open journal"
    }
  ]
}
